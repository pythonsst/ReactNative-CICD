# fastlane configuration — https://docs.fastlane.tools
#
# Primary build + submit for this app is EAS (`yarn eas:build:ios:production`,
# `yarn eas:submit:ios:production`). Fastlane is used here for the one thing EAS
# does not do: uploading App Store **screenshots / metadata**.
#
# ── One-time setup ───────────────────────────────────────────────────────────
# Screenshot upload authenticates with an App Store Connect API key (no 2FA):
#   1. App Store Connect → Users and Access → Integrations → App Store Connect API
#   2. Generate a key with the "App Manager" role, download the .p8 (once!)
#   3. Save it as   ios/fastlane/asc_api_key.p8   (gitignored)
#   4. Export the ids (e.g. in your shell profile or a local .env you source):
#        export ASC_KEY_ID=XXXXXXXXXX
#        export ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#
# ── Everyday use ─────────────────────────────────────────────────────────────
#   bundle exec fastlane screenshots   # upload the images in fastlane/screenshots
#   bundle exec fastlane metadata      # upload the text in fastlane/metadata
# ─────────────────────────────────────────────────────────────────────────────

default_platform(:ios)

WORKSPACE = "ReactNativeIgniteKit.xcworkspace"
DEFAULT_SCHEME = "production"

platform :ios do
  # Load the App Store Connect API key from env + the local .p8 file.
  # Returns the key hash that `deliver` / `upload_to_testflight` accept.
  private_lane :asc_key do
    key_path = File.expand_path("asc_api_key.p8", __dir__)
    unless File.exist?(key_path)
      UI.user_error!(
        "Missing #{key_path}. Download your App Store Connect API key (.p8) and " \
        "save it there. See the setup notes at the top of the Fastfile.",
      )
    end
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path,
      duration: 1200,
      in_house: false,
    )
  end

  desc "Upload App Store screenshots from fastlane/screenshots (no binary, no metadata)"
  lane :screenshots do
    deliver(
      api_key: asc_key,
      screenshots_path: File.expand_path("screenshots", __dir__),
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      force: true, # skip the interactive HTML preview/confirmation
    )
  end

  desc "Upload App Store text metadata from fastlane/metadata (no binary, no screenshots)"
  lane :metadata do
    deliver(
      api_key: asc_key,
      metadata_path: File.expand_path("metadata", __dir__),
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      run_precheck_before_submit: false,
      force: true,
    )
  end

  desc "Build a release archive and push it to TestFlight (EAS is the usual path)"
  lane :beta do
    match(type: "appstore")
    build_app(workspace: WORKSPACE, scheme: DEFAULT_SCHEME)
    upload_to_testflight(api_key: asc_key)
  end
end
