{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "store",
      "channel": "development",
      "autoIncrement": true,
      "environment": "development",
      "android": {
        "gradleCommand": ":app:bundleDevelopmentRelease"
      },
      "ios": {
        "scheme": "development"
      }
    },
    "staging": {
      "distribution": "store",
      "channel": "staging",
      "autoIncrement": true,
      "environment": "staging",
      "android": {
        "gradleCommand": ":app:bundleStagingRelease"
      },
      "ios": {
        "scheme": "staging"
      }
    },
    "staging-apk": {
      "distribution": "internal",
      "channel": "staging",
      "autoIncrement": true,
      "environment": "staging",
      "android": {
        "gradleCommand": ":app:assembleStagingRelease",
        "buildType": "apk"
      },
      "ios": {
        "scheme": "staging",
        "simulator": false
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "gradleCommand": ":app:bundleProductionRelease"
      },
      "ios": {
        "scheme": "production"
      }
    },
    "production-apk": {
      "distribution": "internal",
      "channel": "production",
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "gradleCommand": ":app:assembleProductionRelease",
        "buildType": "apk"
      },
      "ios": {
        "scheme": "production",
        "simulator": false
      }
    }
  },
  "submit": {
    "development": {
      "android": {
        "track": "internal"
      },
      "ios": {
        "bundleIdentifier": "com.snapbiodata.app.development"
      }
    },
    "staging": {
      "android": {
        "applicationId": "com.snapbiodata.app.staging",
        "track": "internal",
        "releaseStatus": "completed"
      },
      "ios": {
        "bundleIdentifier": "com.snapbiodata.app.staging"
      }
    },
    "production": {
      "android": {
        "applicationId": "com.snapbiodata.app",
        "track": "production",
        "changesNotSentForReview": true
      },
      "ios": {
        "ascAppId": "6791839989",
        "bundleIdentifier": "com.snapbiodata.app"
      }
    }
  }
}
